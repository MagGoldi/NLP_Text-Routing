        "source": [
            "import pandas as pd\n",
            "from collections import Counter\n",
            "\n",
            "# 1. Собираем все токены из колонки tokens_no_stop (каждая ячейка — список)\n",
            "all_tokens = [token for sublist in df['tokens_no_stop'] for token in sublist]\n",
            "\n",
            "# 2. Считаем частоту каждого токена и берём 20 самых частотных (можно и просто первые уникальные)\n",
            "token_counts = Counter(all_tokens)\n",
            "top_20_tokens = [word for word, _ in token_counts.most_common(20)]\n",
            "\n",
            "# Альтернатива: взять любые 20 уникальных, не обязательно частых:\n",
            "# top_20_tokens = list(set(all_tokens))[:20]\n",
            "\n",
            "# 3. Применяем стемминг и лемматизацию к каждому слову\n",
