            "### 5) Стемминг vs Лемматизация"
        ]
    },
    {
        "cell_type": "code",
        "execution_count": 214,
        "id": "4018cb0d",
        "metadata": {},
        "outputs": [],
        "source": [
            "def get_stemmer(tokens):\n",
            "    stemmer = SnowballStemmer(\"russian\")\n",
            "\n",
            "    stemmed_tokens = [stemmer.stem(token) for token in tokens]\n",
            "    return stemmed_tokens"
        ]
    },
