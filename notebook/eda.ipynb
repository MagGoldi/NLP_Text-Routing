            "# то можно применить так:\n",
            "stemmed = [get_stemmer([word])[0] for word in top_20_tokens]\n",
            "lemmatized = [get_lemming([word])[0] for word in top_20_tokens]\n",
            "\n",
            "# 4. Создаём сравнительную таблицу\n",
            "comparison_df = pd.DataFrame({\n",
            "    'Слово': top_20_tokens,\n",
            "    'Стемминг': stemmed,\n",
            "    'Лемматизация': lemmatized\n",
            "})\n",
            "\n",
            "print(comparison_df)"
