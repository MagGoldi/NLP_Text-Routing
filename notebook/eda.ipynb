        "source": [
            "def get_stat_text(column):\n",
            "    print(f'Среднее кол-во токенов: {column.str.len().mean()}')\n",
            "    word_freq = defaultdict(int)\n",
            "    for tokens in column:\n",
            "        for token in tokens:\n",
            "            word_freq[token] += 1\n",
            "\n",
            "    print(f\"Кол-во всего токенов: {len(word_freq)}\")\n",
            "    print(f\"Топ популярных: {sorted(word_freq, key=word_freq.get, reverse=True)[:25]}\")"
        ]
    },
    {
        "cell_type": "code",
        "execution_count": 208,
        "id": "ebab0925",
        "metadata": {},
        "outputs": [],
        "source": [
            "def remove_stopwords(tokens, extra_stopwords=None):\n",
            "    russian_stopwords = stopwords.words('russian')\n",
            "    # Объединяем стандартные стоп-слова с пользовательским списком (если он есть)\n",
            "    all_stopwords = set(russian_stopwords)\n",
            "    if extra_stopwords:\n",
            "        all_stopwords.update(extra_stopwords)\n",
            "    \n",
            "    # Фильтруем токены\n",
            "    filtered_tokens = [token for token in tokens if token not in all_stopwords]\n",
            "    return filtered_tokens"
        ]
    },
