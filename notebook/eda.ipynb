            "def clean_text(row):\n",
            "    row = html.unescape(row) \n",
            "    row = re.sub(r\"<.*?>\", \"\", row)\n",
            "    row = row.lower()\n",
            "    row = re.sub(r'[^a-zA-Zа-яё\\s]', '', row)\n",
            "    row = re.sub(r'^\\s+|\\s+$', '', re.sub(r'\\s+', ' ', row))\n",
            "    return row\n",
            "\n",
            "print(df['Текст Сообщения'].head(10))\n",
            "print()    \n",
            "df['Текст Сообщения'].apply(clean_text).head(10)"
        ]
    },
